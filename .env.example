# Copy to .env and fill in. Never commit .env.

# Postgres with pgvector. Matches docker-compose.yml, which maps container
# port 5432 to host port 5433 to avoid clashing with a local Postgres.
DATABASE_URL=postgresql://cardterms:cardterms@localhost:5433/cardterms

# Free tier: https://console.groq.com
# Used for answer generation and for the evaluation judge.
GROQ_API_KEY=
